{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Spring": {
    "Application": {
      "Name": "ChatService"
    }
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": false
    },
    "Instance": {
      "Port": 4099,
      "HostName": "localhost"
    }
  },
  "AppSettings": {
    "AllowedChatOrigins": [
      "http://localhost:8080",
      "http://host.docker.internal:8080",
      "http://localhost:5081"
    ]
  }
}
